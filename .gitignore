# Public source repository: keep data, environments and run archives local.
# Root allowlist: new top-level content must be deliberately reviewed.
/*
!/.gitignore
!/README.md
!/ATTRIBUTION.md
!/LICENSE
!/NOTICE
!/requirements.txt
!/requirements-lock.txt

# Authored implementation and fixed experiment configurations.
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
/scripts/plot_ubfc_peak_comparison_zh_archive.py
!/configs/
/configs/**
!/configs/**/
!/configs/**/*.json

# Public reports. Host-operation journals and historical delivery checklists stay local.
!/docs/
/docs/*
!/docs/*.md
/docs/progress.md
/docs/completion_audit.md

# Upstream notices only; third_party checkouts and weights are not vendored.
!/licenses/
/licenses/*
!/licenses/*-LICENSE.txt

# Generated results are PRIVATE BY DEFAULT.
# Reviewed figures and derived summaries; named demo media exceptions appear below.
!/results/
/results/**

!/results/ubfc_replication/
!/results/ubfc_replication/subject3_reference_sensitivity_en.png
!/results/ubfc_replication/subject3_reference_sensitivity_en.pdf
!/results/ubfc_replication/subject3_reference_sensitivity_en.svg
!/results/ubfc_replication/subject3_reference_sensitivity_en_metadata.json
!/results/ubfc_replication/protocol_lock.json

!/results/ubfc_diagnostics/
!/results/ubfc_diagnostics/audit.json
!/results/ubfc_diagnostics/exact_windows.csv
!/results/ubfc_diagnostics/reference_spectra.png
!/results/ubfc_diagnostics/reference_time_frequency.png
!/results/ubfc_diagnostics/timing_and_device_hr.png
!/results/ubfc_diagnostics/window_sensitivity.json
!/results/ubfc_diagnostics/window_sensitivity.png
!/results/ubfc_diagnostics/window1_window_function_spectra.csv
!/results/ubfc_diagnostics/window2_window_function_spectra.csv

!/results/ubfc_gt_review/
!/results/ubfc_gt_review/comparison.json
!/results/ubfc_gt_review/gt_comparison.png
!/results/ubfc_gt_review/reference_quality.png

!/results/mpu_gt_review/
!/results/mpu_gt_review/comparison.json
!/results/mpu_gt_review/gt_comparison.png
!/results/mpu_gt_review/reference_quality.png

!/results/ubfc_replication_uploaded_v1/
!/results/ubfc_replication_uploaded_v1/comparison.json
!/results/ubfc_replication_uploaded_v1/new_subject_reference_spectra.png
!/results/ubfc_replication_uploaded_v1/new_subject_reference_spectra.pdf
!/results/ubfc_replication_uploaded_v1/new_subject_waveforms.png
!/results/ubfc_replication_uploaded_v1/original_strict_status.csv
!/results/ubfc_replication_uploaded_v1/supplemental_exact_windows.csv
!/results/ubfc_replication_uploaded_v1/supplemental_sensitivity.csv
!/results/ubfc_replication_uploaded_v1/protocol_lock.json
!/results/ubfc_replication_uploaded_v1/verification.json
!/results/ubfc_replication_uploaded_v1/upload_inventory.json

# Small software-verification records (not physiological accuracy claims).
!/results/bigsmall_audit.json
!/results/mtts_serialized_graph_check.json
!/results/signal_math_check.json
!/results/evaluation_software_check.json

# Defense in depth, including accidental nested copies in source directories.
.venv*/
venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials*.json
*.log
*.part
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
.vscode/
.idea/
*.avi
*.mp4
*.mov
*.mkv
*.hdf5
*.h5
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.npy
*.npz
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz

# Explicit local-only roots and the unportable cloned environment snapshot.
/data/
/third_party/
/.venv*/
/requirements-bigsmall-lock.txt

